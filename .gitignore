# Large datasets. Directory layout stays visible through .gitkeep files.
# Shared split files under data/splits/ are not ignored so the group can
# version one fixed split once it exists.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Person 2 recurrent model: MFCC sequence cache and smoke-test output
results/models/recurrent/cache/
results/models/recurrent_smoke/
results/figures/recurrent_smoke/
